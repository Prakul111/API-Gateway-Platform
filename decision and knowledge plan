│   │   └── 0001-record-architecture-decisions.md # Foundational record
│   ├── rfc/                          # Request for Comments / Feature Proposals
│   │   ├── README.md                 # RFC proposal workflow (Draft -> Review -> Accepted -> Done)
│   │   └── 0000-template.md          # Feature specification template
│   ├── bugs/                         # Bug reports, RCA, and post-mortems
│   │   ├── README.md                 # Incident & bug triage guide
│   │   └── 0000-template.md          # Root Cause Analysis (RCA) & fix documentation template
│   ├── improvements/                 # Tech debt, performance audits, and refactoring
│   │   ├── README.md                 # Backlog & audit methodology
│   │   └── 0000-template.md          # Improvement / optimization proposal template
│   └── changelog/                    # Release strategy and changelog policies
