{
  "name": "api-gateway-fullstack",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d && turbo run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter database migrate",
    "db:studio": "pnpm --filter database studio",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "new:adr": "node scripts/doc-scaffold.mjs adr",
    "new:rfc": "node scripts/doc-scaffold.mjs rfc",
    "new:bug": "node scripts/doc-scaffold.mjs bug",
    "new:improvement": "node scripts/doc-scaffold.mjs improvement"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "dotenv-cli": "^11.0.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
