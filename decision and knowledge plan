├── scripts/
│   └── doc-scaffold.mjs              # Fast CLI helper: `pnpm new:adr`, `pnpm new:rfc`, `pnpm new:bug`
└── AGENTS.md                         # Updated with pointers to docs/ and ADR guidelines
```

